# 复制为 .env 并填入真实值(.env 已在 .gitignore 中,不会提交)
# 目标系统的测试环境地址
TARGET_SYSTEM_BASE_URL=https://your-test-host.example.com/api
# 网关签名 appkey(如目标系统用 X5 之类签名协议)
TARGET_SYSTEM_APPKEY=your-appkey-here

# 可选:UI 测试(如目标系统有 UI)
TARGET_SYSTEM_UI_URL=https://your-ui-host.example.com
TARGET_SYSTEM_TEST_USER=your-test-user
TARGET_SYSTEM_TEST_PASSWORD=your-test-password

# 可选:工单回写(Multica 等)
MULTICA_API_URL=https://your-tracker.example.com/api
MULTICA_TOKEN=your-token-here
